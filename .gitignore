# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep secrets local; allow committed templates
.env
.env.*
!.env.example

# PDF.js viewer assets (copied from pdfjs-dist on install)
/public/pdfjs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*

# Supabase CLI local cache
supabase/.temp/

# Internal working notes and compliance drafts (not product source)
/docs/

# Local sales/outreach materials (prospect lists, CASL logs, pitch emails)
/marketing/

# Local brand explorations and name analyses (not product source)
/logo-ideas/
/logo-ideas*.html
/name-analysis/
/naming/

# Local Finance snapshot for the CRM merge (do not push to Yuzu_Immigration)
app-legacy/
