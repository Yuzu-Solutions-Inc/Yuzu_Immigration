# =============================================================================
# MyConsultant — environment template (safe to commit)
# Copy to .env.local and fill secrets. Project ref: cezwtrsleuubrfmbhosn
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel, set this to your production URL (e.g. https://your-app.vercel.app).
# If unset or left as localhost, share links use the request host / VERCEL_URL.
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPABASE_PROJECT_REF=cezwtrsleuubrfmbhosn

NEXT_PUBLIC_SUPABASE_URL=https://cezwtrsleuubrfmbhosn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key for client document files AND client PII columns (64 hex chars).
# Generate with: openssl rand -hex 32
# Keep this in Vercel env too. Table Editor cannot decrypt without this key.
DOCUMENT_ENCRYPTION_KEY=

DATABASE_URL=
DIRECT_DATABASE_URL=

# Google Calendar two-way sync + Google Meet on bookings (server only — never NEXT_PUBLIC_*).
# Create an OAuth client (Web application) in Google Cloud Console,
# enable the Google Calendar API, and add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/google-calendar/callback
# Connecting Calendar in settings also creates a Google Meet link on each booking.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Booking confirmation emails via Resend (server only — never NEXT_PUBLIC_*).
# Create a Resend account, verify your sending domain, then set:
#   RESEND_API_KEY=re_...
#   BOOKING_FROM_EMAIL=My Consultant <bookings@yourdomain.com>
# BOOKING_FROM_EMAIL is the reply mailbox and domain. The visible From is
# per firm, e.g. VF Immigration Bookings <VFImmigration+Bookings@yourdomain.com>.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=

# Daily crons (Hobby: once per day). Reminder emails + Google Calendar watch renewal.
# On Vercel, set the same value — Vercel sends it as Authorization: Bearer.
CRON_SECRET=
