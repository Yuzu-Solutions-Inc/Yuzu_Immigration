# =============================================================================
# MyConsultant — environment template (safe to commit)
# Copy to .env.local and fill secrets. Project ref: cezwtrsleuubrfmbhosn
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel, set this to your production URL (e.g. https://your-app.vercel.app).
# If unset or left as localhost, share links use the request host / VERCEL_URL.
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPABASE_PROJECT_REF=cezwtrsleuubrfmbhosn

NEXT_PUBLIC_SUPABASE_URL=https://cezwtrsleuubrfmbhosn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM wrap key for per-org data keys (64 hex chars).
# Generate with: npm run key:generate   (or: openssl rand -hex 32)
# Keep this in Vercel env too. Table Editor cannot unwrap org keys without it.
DOCUMENT_ENCRYPTION_KEY=
# CLI-only incoming wrap key for `npm run key:rotate`. Not read by the app.
# After execute, copy into DOCUMENT_ENCRYPTION_KEY, redeploy, then delete this line.
DOCUMENT_ENCRYPTION_KEY_ROTATE=

DATABASE_URL=
DIRECT_DATABASE_URL=

# Google Calendar two-way sync + Google Meet on bookings (server only — never NEXT_PUBLIC_*).
# Create an OAuth client (Web application) in Google Cloud Console,
# enable the Google Calendar API and Google Meet API, and add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/google-calendar/callback
# In Settings → Calendar, connect Google Calendar and/or Google Meet independently.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Client portal “Continue with Google” (server only — never NEXT_PUBLIC_*).
# Optional dedicated Web OAuth client. If unset, the calendar client is reused.
# Add this redirect URI on the same OAuth client:
#   {NEXT_PUBLIC_APP_URL}/auth/portal-google/callback
# Firms enable it per workspace in Settings → Organization.
# GOOGLE_PORTAL_CLIENT_ID=
# GOOGLE_PORTAL_CLIENT_SECRET=

# Microsoft 365 / Outlook Calendar two-way sync + Teams on bookings (server only).
# Register an Entra ID app (Accounts in any org directory + personal Microsoft accounts),
# add a Web redirect URI, and grant delegated Calendars.ReadWrite + OnlineMeetings.ReadWrite
# + User.Read + offline_access:
#   {NEXT_PUBLIC_APP_URL}/auth/microsoft-calendar/callback
# In Settings → Calendar, connect Outlook and/or Teams independently.
# Optional tenant: common (default), organizations, or a specific tenant ID.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_TENANT=common

# Zoom Meeting join links on bookings (server only — never NEXT_PUBLIC_*).
# Create a General OAuth app at https://marketplace.zoom.us/ and add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/zoom/callback
# Scopes: meeting:write:meeting, meeting:update:meeting, meeting:delete:meeting, user:read:user.
# In Settings → Calendar, connect Zoom under Meetings. Independent of Google or Outlook calendar.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Square payments for priced bookings + project payment links (server only).
# Create an application at https://developer.squareup.com/
# OAuth redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/square/callback
# Webhook URL (payment.updated, order.updated):
#   {NEXT_PUBLIC_APP_URL}/api/square/webhook
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Sage Business Cloud Accounting (server only — never NEXT_PUBLIC_*).
# Register an app at https://developer.sage.com/accounting/
# OAuth redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/sage/callback
# In Settings → Payments, connect Sage, map Canadian tax rates, and pick a sales ledger.
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# Booking confirmation emails via Resend (server only — never NEXT_PUBLIC_*).
# Create a Resend account, verify your sending domain, then set:
#   RESEND_API_KEY=re_...
#   BOOKING_FROM_EMAIL=My Consultant <bookings@yourdomain.com>
# BOOKING_FROM_EMAIL is the reply mailbox and domain. The visible From is
# per firm, e.g. VF Immigration Bookings <VFImmigration+Bookings@yourdomain.com>.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=

# Daily crons (Hobby: once per day). Reminder emails + calendar watch renewal.
# On Vercel, set the same value — Vercel sends it as Authorization: Bearer.
CRON_SECRET=
