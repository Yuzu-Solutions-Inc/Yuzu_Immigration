# =============================================================================
# Dossierly — environment template (safe to commit)
# Copy to .env.local and fill secrets.
#
# Local + Vercel Preview/Development → Yuzu Solutions Inc. (gqpafbmlherrwuigsjxy)
# Vercel Production (dossierly.ca)   → MyConsultant (cezwtrsleuubrfmbhosn)
# Do not reuse DOCUMENT_ENCRYPTION_KEY across those two projects.
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://www.dossierly.ca
# Preview (yuzu-crm): https://preview.dossierly.ca — same OAuth apps as production;
# add these extra redirect URIs on each existing client (do not create a second app):
#   https://preview.dossierly.ca/auth/callback
#   https://preview.dossierly.ca/auth/google-calendar/callback
#   https://preview.dossierly.ca/auth/portal-google/callback
#   https://preview.dossierly.ca/auth/microsoft-calendar/callback
#   https://preview.dossierly.ca/auth/zoom/callback
#   https://preview.dossierly.ca/auth/square/callback
#   https://preview.dossierly.ca/auth/sage/callback
# DNS: CNAME preview → 73ad8c9714280ce7.vercel-dns-017.com
# Per-commit hostnames cannot be used for OAuth (providers require exact URIs).
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPABASE_PROJECT_REF=gqpafbmlherrwuigsjxy

NEXT_PUBLIC_SUPABASE_URL=https://gqpafbmlherrwuigsjxy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM wrap key for per-org data keys (64 hex chars).
# Generate with: npm run key:generate   (or: openssl rand -hex 32)
# Keep this in Vercel env too. Table Editor cannot unwrap org keys without it.
DOCUMENT_ENCRYPTION_KEY=
# CLI-only incoming wrap key for `npm run key:rotate`. Not read by the app.
# After execute, copy into DOCUMENT_ENCRYPTION_KEY, redeploy, then delete this line.
DOCUMENT_ENCRYPTION_KEY_ROTATE=

DATABASE_URL=
DIRECT_DATABASE_URL=

# Google Calendar two-way sync + Google Meet on bookings (server only — never NEXT_PUBLIC_*).
# Create an OAuth client (Web application) in Google Cloud Console,
# enable the Google Calendar API (not Meet API), and add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/google-calendar/callback
# OAuth consent screen scopes: calendar.events, openid, email only.
# Extra sensitive scopes (calendar.freebusy, meetings.space.created) show Google's
# unverified-app screen until they are separately verified. Meet join links use
# Calendar conference data, which is covered by calendar.events.
# In Settings → Calendar, connect Google Calendar and/or Google Meet independently.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Client portal “Continue with Google” (server only — never NEXT_PUBLIC_*).
# Optional dedicated Web OAuth client. If unset, the calendar client is reused.
# Add this redirect URI on the same OAuth client:
#   {NEXT_PUBLIC_APP_URL}/auth/portal-google/callback
# Firms enable it per workspace in Settings → Organization.
# GOOGLE_PORTAL_CLIENT_ID=
# GOOGLE_PORTAL_CLIENT_SECRET=

# Microsoft 365 / Outlook Calendar two-way sync + Teams on bookings (server only).
# Register an Entra ID app (Accounts in any org directory + personal Microsoft accounts),
# add a Web redirect URI, and grant delegated Calendars.ReadWrite + OnlineMeetings.ReadWrite
# + User.Read + offline_access:
#   {NEXT_PUBLIC_APP_URL}/auth/microsoft-calendar/callback
# In Settings → Calendar, connect Outlook and/or Teams independently.
# Optional tenant: common (default), organizations, or a specific tenant ID.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_TENANT=common

# Zoom Meeting join links on bookings (server only — never NEXT_PUBLIC_*).
# Create a General OAuth app at https://marketplace.zoom.us/ and add this redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/zoom/callback
# Scopes: meeting:write:meeting, meeting:update:meeting, meeting:delete:meeting, user:read:user.
# In Settings → Calendar, connect Zoom under Meetings. Independent of Google or Outlook calendar.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Square payments for priced bookings + project payment links (server only).
# Create an application at https://developer.squareup.com/
# OAuth redirect URI (Square Developer Console → app → OAuth):
#   https://www.dossierly.ca/auth/square/callback
# Webhook notification URL (Webhooks → Subscriptions):
#   https://www.dossierly.ca/api/square/webhook
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Sage Business Cloud Accounting (server only — never NEXT_PUBLIC_*).
# Register an app at https://developer.sage.com/accounting/
# OAuth redirect URI:
#   {NEXT_PUBLIC_APP_URL}/auth/sage/callback
# In Settings → Payments, connect Sage, map Canadian tax rates, and pick a sales ledger.
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# Booking / product emails via Resend (server only — never NEXT_PUBLIC_*).
# Verify a sending *subdomain* (e.g. mail.yourdomain.com) so firm Google/Microsoft
# MX on the root domain is untouched. Then set:
#   RESEND_API_KEY=re_...
#   BOOKING_FROM_EMAIL=Dossierly <bookings@mail.dossierly.ca>
# BOOKING_FROM_EMAIL is the From address for notifications. Replies are blocked
# (no Reply-To). Footers include the consultant or org privacy contact email.
# Delivery webhooks: POST {APP_URL}/api/resend/webhook — copy the signing secret:
#   RESEND_WEBHOOK_SECRET=whsec_...
# Do not enable Resend Receiving for CRM messaging.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Daily crons (Hobby: once per day). Reminder emails + calendar watch renewal.
# On Vercel, set the same value — Vercel sends it as Authorization: Bearer.
CRON_SECRET=

# Stripe Billing for Dossierly subscriptions (server only — never NEXT_PUBLIC_*
# except the publishable key). Provision via Vercel Marketplace:
#   vercel integration add stripe -m defaultCountry=CA -m defaultCurrency=CAD
# Webhook URL (Billing + Connect client payments; enable events from connected accounts):
#   {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# Optional second secret if you use a dedicated Connect endpoint:
# STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
