# =============================================================================
# MyConsultant — environment template (safe to commit)
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY. Never expose to the browser / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection (Project Settings → Database → Connection string URI)
# Prefer the pooled connection for the app; use direct for migrations if needed.
DATABASE_URL=
DIRECT_DATABASE_URL=
